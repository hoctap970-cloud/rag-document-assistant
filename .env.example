# Copy this file to .env only if you use a tool that loads .env files.
# IntelliJ users should add GEMINI_API_KEY to the Run Configuration instead.
GEMINI_API_KEY=replace-with-your-own-key
# Optional: choose a model available to your account, then run the live evaluation.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_VISION_ENABLED=true
# Optional: false saves the extra rerank call; vector + BM25 and answer still run.
RAG_RERANK_ENABLED=true
